{
    "name": "syriable/laravel-localizer",
    "description": "A modern, focused localization extraction engine for Laravel 13. Discovers, extracts, and normalizes translatable strings from Blade, PHP, Vue, JS, TS, Livewire, and Inertia source files. Pre-1.0 — API may evolve based on user feedback.",
    "keywords": [
        "laravel",
        "localization",
        "i18n",
        "translation",
        "extraction",
        "scanner",
        "blade",
        "vue",
        "inertia",
        "livewire",
        "syriable"
    ],
    "homepage": "https://github.com/syriable/laravel-localizer",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Syriable",
            "homepage": "https://github.com/syriable",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/pipeline": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/finder": "^7.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.4.1",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Syriable\\Localizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syriable\\Localizer\\Tests\\": "tests/"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test",
        "check": [
            "@format-check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Syriable\\Localizer\\LocalizerServiceProvider"
            ],
            "aliases": {
                "Localizer": "Syriable\\Localizer\\Facades\\Localizer"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
