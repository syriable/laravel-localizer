{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "concat_space": {
            "spacing": "none"
        },
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters"
            ]
        },
        "phpdoc_align": {
            "align": "vertical"
        },
        "method_chaining_indentation": true,
        "binary_operator_spaces": {
            "default": "single_space"
        }
    },
    "exclude": [
        "vendor"
    ]
}
